{
  "name": "aabhushan-erp-mcp-server",
  "version": "1.0.0",
  "description": "Streamable HTTP MCP server for the Aabhushan jewellery ERP (stateless, serverless-friendly)",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.3" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/local.js",
    "dev": "tsx watch src/local.ts",
    "smoke": "tsx scripts/smoke.ts",
    "migrate": "tsx scripts/migrate.ts",
    "create-key": "tsx scripts/create-key.ts",
    "revoke-key": "tsx scripts/revoke-key.ts",
    "list-keys": "tsx scripts/list-keys.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
