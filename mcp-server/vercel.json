{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run typecheck",
  "outputDirectory": "public",
  "functions": {
    "api/*.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/mcp/(.*)", "destination": "/api/mcp" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/resource-metadata" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/resource-metadata" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Cache-Control", "value": "no-store" } ] }
  ]
}
