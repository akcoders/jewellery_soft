# ---- Required ---------------------------------------------------------------
# Base URL of the ERP (CodeIgniter app). No trailing slash. The /api/mobile/* and
# /api/mcp/session routes are resolved under it.
ERP_BASE_URL=https://aabhushan.webignitors.in/public

# Shared secret that the ERP checks on POST /api/mcp/session (X-MCP-Secret header).
# Must equal mcp.sharedSecret in the ERP's .env.
MCP_ERP_SHARED_SECRET=change-me-long-random-string

# 32+ random bytes, base64 or hex. Encrypts cached ERP session tokens at rest.
MCP_TOKEN_SECRET=change-me-32-bytes-random

# ---- State database (external MySQL) ----------------------------------------
# Holds API keys, audit log and cached ERP sessions. Any MySQL 8 / MariaDB host
# works (the ERP database itself with Remote MySQL enabled, or a hosted MySQL).
# mysql://user:password@host:3306/database?ssl=true
MCP_DATABASE_URL=

# ---- Optional ----------------------------------------------------------------
# Public URL of the MCP endpoint. Enables resource checks and the 401 challenge URL.
MCP_PUBLIC_URL=https://mcp.example.com/mcp

# Comma separated hostnames allowed in the Host header (leave empty on Vercel).
MCP_ALLOWED_HOSTS=

# Read-only MySQL connection to the ERP database for the erp_sql_* tools.
# Use a MySQL user that only has SELECT. Leave empty to disable SQL tools.
ERP_DATABASE_URL=

# Bootstrap / local testing without a state database: one static API key that
# maps to the given ERP admin user with all scopes. Remove in production.
MCP_BOOTSTRAP_KEY=
MCP_BOOTSTRAP_ADMIN_USER_ID=1

# Local dev server port (npm run dev / npm start). Not used on Vercel.
PORT=3939
