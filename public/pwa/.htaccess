Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Gate nested static apps before their own file/directory exceptions.
  # Use the correct response URL for either supported document root.
  RewriteCond %{DOCUMENT_ROOT}/service-suspended.flag -f
  RewriteRule ^ /service-suspended.php [END]
  RewriteCond %{DOCUMENT_ROOT}/public/service-suspended.flag -f
  RewriteRule ^ /public/service-suspended.php [END]
  RewriteBase /pwa/
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|wasm|png|jpg|jpeg|webp|svg|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^(index\.html|manifest\.json|version\.json|flutter_bootstrap\.js|main\.dart\.js|aabhushan_pwa_bridge\.js|aabhushan_app_sw\.js|OneSignalSDKWorker\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

AddType application/javascript .js
AddType application/manifest+json .json
AddType application/wasm .wasm
